# Copy to .env and fill in real values. Never commit .env.

# Claude API (Synthesis Engine) — see SPEC.md section 4
ANTHROPIC_API_KEY=

# Financial Modeling Prep — economic calendar (SPEC.md section 1.4, economic_events)
FMP_API_KEY=

# Finnhub — earnings calendar + supplementary news headlines (SPEC.md section 1.4)
FINNHUB_API_KEY=

# Alpha Vantage — primary news sentiment source (SPEC.md section "מקורות נתונים" / section 4)
ALPHA_VANTAGE_API_KEY=

# Database URL. Default: local SQLite file. Postgres example:
# postgresql+psycopg://user:password@host:5432/fendomental
DB_URL=sqlite:///./fendomental.db
